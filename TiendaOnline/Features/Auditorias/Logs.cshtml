@using TiendaOnline.Features.Auditorias
@using TiendaOnline.Features.Shared.ViewModels
@model LogsViewModel
@{
    ViewData[ViewDataKeys.Title] = "Auditoría del Sistema";

    // Se declaran todas las pills posibles: el filtro final descarta las que no tienen valor.
    var filtrosActivos = new List<FiltroPill>
    {
        new("bi-search", "Auditorías", Model.Busqueda, nameof(Model.Busqueda)),
        new("bi-table", "Entidad", Model.TablaAfectada, nameof(Model.TablaAfectada)),
        new("bi-hash", "ID", Model.EntidadId, nameof(Model.EntidadId)),
        new("bi-calendar-event", "Desde", Model.FechaDesde?.ToString("dd/MM/yyyy"), nameof(Model.FechaDesde)),
        new("bi-calendar-event", "Hasta", Model.FechaHasta?.ToString("dd/MM/yyyy"), nameof(Model.FechaHasta)),
    }
    .Where(filtro => !string.IsNullOrWhiteSpace(filtro.Valor))
    .ToList();
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <partial name="_TituloSeccion" model='("Auditoría del Sistema", "Registro completo de todas las acciones realizadas en el sistema")' />

    <!-- Filtros -->
    <button class="btn btn-outline-primary w-100 mb-3 d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#filtrosLogs" aria-controls="filtrosLogs">
        <i class="bi bi-funnel me-1"></i>Filtros
        @if (filtrosActivos.Count > 0)
        {
            <span class="badge bg-primary rounded-pill ms-1">@filtrosActivos.Count</span>
        }
    </button>

    <div class="offcanvas-md offcanvas-bottom filtros-panel" id="filtrosLogs">
        <div class="offcanvas-body">
            <div class="d-md-none text-end mb-2">
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>
    <form method="get" asp-action="Logs">
        @* El historial de una entidad viaja oculto: buscar o mover fechas no lo pierde. *@
        @if (!string.IsNullOrEmpty(Model.TablaAfectada))
        {
            <input type="hidden" name="TablaAfectada" value="@Model.TablaAfectada" />
        }
        @if (!string.IsNullOrEmpty(Model.EntidadId))
        {
            <input type="hidden" name="EntidadId" value="@Model.EntidadId" />
        }
        <div class="row mb-4">
            <div class="col-12">
                <div class="card rounded-3 border">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-2">
                                <label class="form-label fw-bold text-muted small">Mostrar</label>
                                <select name="TamanoPagina" class="form-select">
                                    @{
                                        int[] opciones = { 10, 25, 50, 75, 100 };
                                        foreach (var cantidad in opciones)
                                        {
                                            <option value="@cantidad" selected="@(Model.Paginacion.RegistrosPorPagina == cantidad ? "selected" : null)">
                                                @cantidad registros
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-search me-1"></i>Búsqueda
                                </label>
                                <input type="text" name="Busqueda" value="@Model.Busqueda" class="form-control" placeholder="Usuario, tabla, acción o ID...">
                            </div>

                            <div class="col-md-6 col-lg-2">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar me-1"></i>Desde
                                </label>
                                <input type="date" name="FechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control">
                            </div>
                            <div class="col-md-6 col-lg-2">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar me-1"></i>Hasta
                                </label>
                                <input type="date" name="FechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control">
                            </div>

                            <div class="col-md-6 col-lg-3 d-flex align-items-end gap-2">
                                <button type="submit" class="btn btn-primary flex-fill" title="Aplicar filtros">
                                    <i class="bi bi-filter me-1"></i>
                                </button>

                                <button type="submit" class="btn btn-outline-success flex-fill"
                                        formaction="@Url.Action("Exportar")" formmethod="get"
                                        title="Exportar este historial a CSV">
                                    <i class="bi bi-filetype-csv me-1"></i>
                                </button>

                                <a asp-action="Logs" class="btn btn-outline-secondary flex-fill" title="Limpiar filtros">
                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
        </div>
    </div>

    <!-- Resumen resultados -->
    <partial name="_ResumenResultados" 
        model="@(new ResumenResultadosViewModel{
                    TotalRegistros = Model.Paginacion.TotalRegistros,
                    Desde = Model.Paginacion.DesdeRegistro,
                    Hasta = Model.Paginacion.HastaRegistro,
                    NombreEntidad = "auditorias",
                    ActionName = "Logs",
                    Filtros = filtrosActivos
    })" />

    <!-- Tabla de Auditoría -->
    <div class="row">
        <div class="col-12">
            <div class="card rounded-3 shadow border-0 px-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="tablaAuditoria">
                            <thead>
                                <tr>
                                    <th class="border-0 py-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-clock me-2 text-primary"></i>
                                            Fecha y Hora
                                        </div>
                                    </th>
                                    <th class="border-0 py-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person me-2 text-primary"></i>
                                            Usuario
                                        </div>
                                    </th>
                                    <th class="border-0 py-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-activity me-2 text-primary"></i>
                                            Acción
                                        </div>
                                    </th>
                                    <th class="border-0 py-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-table me-2 text-primary"></i>
                                            Entidad
                                        </div>
                                    </th>
                                    <th class="border-0 py-3 text-center">
                                        <i class="bi bi-gear me-1 text-primary"></i>Acciones
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Paginacion.Items)
                                {
                                    <tr>
                                        <td class="py-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold">@item.Fecha.ToString("dd/MM/yyyy")</span>
                                                <small class="text-muted">@item.Fecha.ToString("HH:mm:ss")</small>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <div>
                                                <div class="fw-semibold">@item.UsuarioNombreCompleto</div>
                                                <small class="text-muted">@item.UsuarioEmail</small>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="badge bg-info px-3 py-2 rounded-pill small fw-medium">@item.Accion</span>
                                        </td>
                                        <td class="py-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold">@item.TablaAfectada</span>
                                                <small class="text-muted">#@item.EntidadId</small>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <div class="d-flex justify-content-center gap-1">
                                                <button class="btn btn-sm btn-primary btn-ver-detalle" data-id="@item.AuditoriaId">
                                                    <i class="bi bi-eye me-1"></i> Ver Cambios
                                                </button>
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-action="Logs"
                                                   asp-route-TablaAfectada="@item.TablaAfectada"
                                                   asp-route-EntidadId="@item.EntidadId"
                                                   title="Ver el historial completo de esta entidad">
                                                    <i class="bi bi-clock-history"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <partial name="_Paginacion" model="@(new PaginacionViewModel { 
        PaginaActual = Model.Paginacion.PaginaActual, 
        TotalPaginas = Model.Paginacion.TotalPaginas, 
        Accion = "Logs" 
    })" />
</div>

<!-- Modal de detalle de los cambios -->
<div class="modal fade" id="modalCambios" tabindex="-1" aria-labelledby="etiquetaModalCambios" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div class="me-auto">
                    <h5 class="modal-title" id="etiquetaModalCambios">
                        <i class="bi bi-file-diff me-2"></i>Detalles de los Cambios
                    </h5>
                    <div id="subtituloCambios" class="small text-muted"></div>
                </div>
                <div class="btn-group btn-group-sm me-3" role="group" aria-label="Vista de los cambios">
                    <button type="button" class="btn btn-outline-secondary active" data-vista-cambios="diff">Campos</button>
                    <button type="button" class="btn btn-outline-secondary" data-vista-cambios="json">JSON</button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="vistaDiffCambios">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 25%;">Campo</th>
                                    <th style="width: 37.5%;">Anterior</th>
                                    <th style="width: 37.5%;">Nuevo</th>
                                </tr>
                            </thead>
                            <tbody id="cuerpoDiffCambios"></tbody>
                        </table>
                    </div>
                    <p id="diffSinDatos" class="text-muted small mb-0 d-none">Sin datos registrados.</p>
                </div>

                <div id="vistaJsonCambios" class="row d-none">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-arrow-left-circle me-2"></i>Datos Anteriores
                        </h6>
                        <div class="bg-body-secondary p-3 rounded">
                            <pre id="datosAnteriores" class="small lh-sm mb-0" style="white-space: pre-wrap;"></pre>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-arrow-right-circle me-2"></i>Datos Nuevos
                        </h6>
                        <div class="bg-body-secondary p-3 rounded">
                            <pre id="datosNuevos" class="small lh-sm mb-0" style="white-space: pre-wrap;"></pre>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-2" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div> 

@section Scripts {
    <script src="~/js/Features/Auditorias/Logs.js" asp-append-version="true"></script>
}
