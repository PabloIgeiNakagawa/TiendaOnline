@using TiendaOnline.Enums
@using TiendaOnline.Features.Shared
@{
    var mensaje = TempData.GetMensaje();
}

@if (mensaje != null)
{
    @* Medio abajo, por encima del header sticky (1100 = el mismo z-index que
       usan los dropdowns para superar la barra fija). En móvil el mb-5 lo deja
       justo arriba de la barra de tabs fixed-bottom *@
    <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3 mb-5 mb-lg-0" style="z-index: 1100;">
        @if (mensaje.Tipo == TipoMensaje.Error)
        {
            <div class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-x-circle-fill me-2"></i>@mensaje.Texto</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        else
        {
            <div class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle-fill me-2"></i>@mensaje.Texto</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
    </div>
}
