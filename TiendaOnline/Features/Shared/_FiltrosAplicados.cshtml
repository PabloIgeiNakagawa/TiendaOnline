@using TiendaOnline.Features.Shared.ViewModels
@model FiltrosAplicadosViewModel
@{
    // Limpiar todo: la query actual sin los parámetros de todas las pills
    // (queda el tamaño de página, que no es un filtro). Case-insensitive: la query
    // viaja con el casing del form y la pill puede venir de nameof()
    var routeLimpia = Context.Request.Query.ToDictionary(
        k => k.Key,
        v => v.Value.ToString(),
        StringComparer.OrdinalIgnoreCase);
    foreach (var filtro in Model.Filtros)
    {
        if (!string.IsNullOrEmpty(filtro.Propiedad))
        {
            routeLimpia.Remove(filtro.Propiedad);
        }
        foreach (var extra in filtro.PropiedadesAdicionales)
        {
            routeLimpia.Remove(extra);
        }
    }
}

@if (Model.Filtros.Any())
{
    <span class="small text-muted me-1">Filtros:</span>
    @foreach (var filtro in Model.Filtros)
    {
        // Clonamos TODOS los parámetros que están actualmente en la URL (case-insensitive:
        // la query viaja con el casing del form y la pill puede venir de nameof())
        var routeData = Context.Request.Query.ToDictionary(
        k => k.Key,
        v =>
            {
                // StringValues puede contener múltiples valores, pero aquí asumimos el primero
                var valueStr = v.Value.ToString();
                DateTime dt;
                // Intentamos analizar como fecha, si es posible
                if (DateTime.TryParse(valueStr, out dt))
                {
                    return dt.ToString("yyyy-MM-dd");
                }
                return valueStr;
            },
            StringComparer.OrdinalIgnoreCase); // Para evitar cambios de formato en la fecha.

        // Removemos de la URL el parámetro de ESTA píldora y la página (para volver a la 1)
        if (!string.IsNullOrEmpty(filtro.Propiedad))
        {
            routeData.Remove(filtro.Propiedad);
        }

        foreach (var extra in filtro.PropiedadesAdicionales)
        {
            routeData.Remove(extra);
        }

        <div class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle d-flex align-items-center px-3 py-2">
            <i class="bi @filtro.Icono me-2"></i>
            <span class="fw-normal">@filtro.Etiqueta: <strong>@filtro.Valor</strong></span>
            <a asp-action="@Model.ActionName"
               asp-all-route-data="routeData"
               asp-route-pagina="1"
               title="Quitar filtro"
               class="ms-2 text-secondary-emphasis d-inline-flex align-items-center text-decoration-none">
                <i class="bi bi-x-circle-fill opacity-50 hover-opacity-100"></i>
            </a>
        </div>
    }

    <a asp-action="@Model.ActionName" asp-all-route-data="@routeLimpia" asp-route-pagina="1" class="btn btn-link btn-sm text-danger text-decoration-none fw-bold ms-1">
        <i class="bi bi-trash3 me-1"></i>Limpiar todo
    </a>
}
