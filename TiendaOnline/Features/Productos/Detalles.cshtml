@using TiendaOnline.Features.Productos
@model DetallesViewModel
@{
    ViewData[ViewDataKeys.Title] = $"Detalles - {Model.Nombre}";
}
<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="my-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Inicio</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-action="Index" class="text-decoration-none">Productos</a>
        </li>
        @if (Model.CategoriaNombre != null)
        {
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-route-CategoriaId="@Model.CategoriaId" class="text-decoration-none">@Model.CategoriaNombre</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
    </ol>
</nav>

<div class="container-fluid">
    <div class="row">
        <!-- Visor del producto: slide 0 = imagen principal (la misma que leen el
             resto de las vistas), los slides siguientes son las extras de la
             galería. Carousel de Bootstrap con thumbnails verticales a la
             izquierda como indicadores: el cambio de imagen es data-bs-target,
             sin JS propio. La caja es de altura fija (object-fit-contain): la
             imagen no agranda ni achica el visor según su aspect ratio. -->
        <div class="col-lg-6 col-md-6 mb-4">
            @{
                var visor = new List<string>();
                if (!string.IsNullOrEmpty(Model.ImagenUrl) && !Model.ImagenUrl.Contains("no-image.png"))
                    visor.Add(Model.ImagenUrl);
                if (Model.Imagenes != null)
                    visor.AddRange(Model.Imagenes.Where(u => !string.IsNullOrEmpty(u) && !u.Contains("no-image.png")));
            }

            @if (visor.Count == 0)
            {
                <div class="d-flex align-items-center justify-content-center rounded-3 border bg-body-tertiary" style="height: 440px;">
                    <div class="text-center text-body-secondary">
                        <i class="bi bi-image fs-1 d-block mb-2"></i>Sin imagen disponible
                    </div>
                </div>
            }
            else if (visor.Count == 1)
            {
                <div class="d-flex align-items-center justify-content-center rounded-3 border bg-body-tertiary" style="height: 440px;">
                    <img src="@visor[0]" class="w-100 h-100 object-fit-contain" alt="@Model.Nombre" />
                </div>
            }
            else
            {
                @* El carousel mismo es el flex: columna de thumbnails (order
                   natural, izquierda) + slide fijo a la derecha. position-static
                   y los estilos inline pisan el indicador default de Bootstrap
                   (3px, absolute); el toggle de .active lo hace Bootstrap solo. *@
                <div id="visorProducto" class="carousel slide d-flex gap-2 align-items-start" data-bs-ride="false">
                    <div class="carousel-indicators position-static flex-column justify-content-start gap-2 mt-0 mb-0 mx-0">
                        @for (var i = 0; i < visor.Count; i++)
                        {
                            <button type="button" data-bs-target="#visorProducto" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"
                                    aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Ir a la imagen @(i + 1)"
                                    style="width: 64px; height: 64px; text-indent: 0; margin: 0; border-radius: .375rem; overflow: hidden;">
                                <img src="@visor[i]" alt="" class="w-100 h-100 object-fit-cover" />
                            </button>
                        }
                    </div>

                    <div class="carousel-inner rounded-3 border bg-body-tertiary flex-grow-1" style="height: 440px;">
                        @for (var i = 0; i < visor.Count; i++)
                        {
                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                <img src="@visor[i]" class="d-block w-100 h-100 object-fit-contain"
                                     alt="@(Model.Nombre) - imagen @(i + 1)" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Información del Producto -->
        <div class="col-lg-6 col-md-6">
            <div>
                <!-- Categoría y stock -->
                @if (Model.CategoriaNombre != null)
                {
                    <div class="producto-categoria-detalle mb-3">
                        <span class="bg-body-secondary border fw-semibold px-2 py-1 rounded-pill small me-2">
                            <i class="bi bi-tag"></i> @Model.CategoriaNombre
                        </span>
                        @if (Model.Stock > 0 && Model.Stock <= 5)
                        {
                            <span class="badge bg-warning text-dark">Últimas unidades</span>
                        }
                        else if (Model.Stock <= 0)
                        {
                            <span class="badge bg-danger">Agotado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                    </div>
                }

                <!-- Título -->
                <h1 class="mb-3">@Model.Nombre</h1>

                <!-- Descripción -->
                <div class="mb-4">
                    <p class="lead">@Model.Descripcion</p>
                </div>

                <hr class="my-4 opacity-10">

                <!-- Precio mostrado: efectivo = mejor oferta vigente ?? lista -->
                <div class="mb-4">
                    @if (Model.PrecioOferta.HasValue)
                    {
                        var descuento = Model.Precio > 0
                            ? Math.Round(100m - (Model.PrecioOferta.Value / Model.Precio) * 100m, 0, MidpointRounding.AwayFromZero)
                            : -1m;
                        <span class="badge bg-danger fs-6 mb-2">@(descuento > 0 ? $"{descuento:0}% OFF" : "EN OFERTA")</span>
                        <div>
                            <span class="fs-2 fw-bold text-danger">@Model.PrecioOferta.Value.ToString("C", new System.Globalization.CultureInfo("es-AR"))</span>
                            <small class="fs-3 text-muted text-decoration-line-through">@Model.Precio.ToString("C", new System.Globalization.CultureInfo("es-AR"))</small>
                            <small>ARS</small>
                        </div>
                        <small class="text-muted d-block mt-1">
                            <i class="bi bi-clock me-1"></i>Promoción vigente hasta @Model.FechaFinOferta?.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    }
                    else
                    {
                        <div>
                            <span class="fs-2 fw-bold">@Model.Precio.ToString("C", new System.Globalization.CultureInfo("es-AR"))</span>
                            <small class="fs-2">ARS</small>
                        </div>
                    }
                </div>

                <!-- Formulario para agregar al carrito -->
                @if (Model.Stock > 0)
                {
                    <form asp-controller="Carritos" asp-action="Agregar" method="post" class="producto-acciones-detalle" data-agregar-carrito>
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@Model.ProductoId" />

                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="d-grid gap-2 d-md-flex">
                                    <button type="submit" class="btn btn-primary btn-lg flex-fill">
                                        <i class="bi bi-cart-plus me-2"></i>Agregar al Carrito
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div>
                        <div class="d-grid">
                            <button class="btn btn-outline-secondary btn-lg" disabled>
                                <i class="bi bi-x-circle me-2"></i>Producto Agotado
                            </button>
                        </div>
                    </div>
                }

                <!-- Información adicional -->
                <div class="card bg-body-tertiary border-0 rounded-4 my-4">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-truck text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Envío a todo el país</h6>
                                <p class="small text-muted mb-0">Calculá el costo en el checkout.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start">
                            <i class="bi bi-shield-check text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Garantía de Satisfacción</h6>
                                <p class="small text-muted mb-0">30 días para devoluciones gratuitas.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Botones de navegación -->
                <div class="my-4">
                    <a asp-action="Index" class="btn text-secondary-emphasis"><i class="bi bi-arrow-left"></i> Volver a productos</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Features/Productos/AgregarCarrito.js" asp-append-version="true"></script>
}