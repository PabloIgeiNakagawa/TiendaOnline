@using TiendaOnline.Features.Home
@model ResumenDiarioViewModel

@* Fragmento del widget "Resumen Diario": las 4 tarjetas (la venta es la
   cobrada: subtotal + envío — misma regla que el dashboard de reportes). *@
<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Ventas hoy</p>
                    <h3 class="mb-0 fw-bold">@Model.FormatoMoneda(Model.VentasHoy)</h3>
                </div>
                <div class="bg-success bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-currency-dollar text-success fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                @if (Model.PorcentajeVentas >= 0)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-up"></i> @Model.PorcentajeVentas.ToString("F1")%
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-down"></i> @Math.Abs(Model.PorcentajeVentas).ToString("F1")%
                    </span>
                }
                <small class="text-muted ms-1">vs ayer</small>
            </div>
        </div>
    </div>
</div>
<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Pedidos hoy</p>
                    <h3 class="mb-0 fw-bold">@Model.PedidosHoy</h3>
                </div>
                <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-receipt text-primary fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                @if (Model.PorcentajePedidos >= 0)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-up"></i> @Model.PorcentajePedidos.ToString("F1")%
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-down"></i> @Math.Abs(Model.PorcentajePedidos).ToString("F1")%
                    </span>
                }
                <small class="text-muted ms-1">vs ayer</small>
            </div>
        </div>
    </div>
</div>
<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Enviados hoy</p>
                    <h3 class="mb-0 fw-bold">@Model.EnviadosHoy</h3>
                </div>
                <div class="bg-info bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-truck text-info fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                @if (Model.PorcentajeEnviados >= 0)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-up"></i> @Model.PorcentajeEnviados.ToString("F1")%
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-down"></i> @Math.Abs(Model.PorcentajeEnviados).ToString("F1")%
                    </span>
                }
                <small class="text-muted ms-1">vs ayer</small>
            </div>
        </div>
    </div>
</div>
<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Stock bajo</p>
                    <h3 class="mb-0 fw-bold">@Model.StockBajo</h3>
                </div>
                <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                <small class="text-muted">productos con menos de 5 unidades</small>
            </div>
        </div>
    </div>
</div>
