@using TiendaOnline.Features.Home
@model HomeAdminViewModel
@{
    ViewData[ViewDataKeys.Title] = "Inicio";
}
@section Styles{
    <style>
        .luz-parpadeante {
            box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); /* Color verde por defecto */
            animation: pulso-verde 2s infinite;
        }

        /* Si está offline (rojo), cambiamos el color del pulso */
        .bg-danger.luz-parpadeante {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
            animation: pulso-rojo 2s infinite;
        }

        @@keyframes pulso-verde {
            0% {
                transform: translate(-50%, -50%) scale(0.95);
                box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
            }

            70% {
                transform: translate(-50%, -50%) scale(1);
                box-shadow: 0 0 0 10px rgba(40, 167, 69, 0);
            }

            100% {
                transform: translate(-50%, -50%) scale(0.95);
                box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
            }
        }

        @@keyframes pulso-rojo {
            0% {
                transform: translate(-50%, -50%) scale(0.95);
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
            }

            70% {
                transform: translate(-50%, -50%) scale(1);
                box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
            }

            100% {
                transform: translate(-50%, -50%) scale(0.95);
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
            }
        }
    </style>
}

@* CAPARAZÓN: la página no consulta la base — cada contenedor declara su carga
   con data-cargar (endpoint del fragmento) + data-esqueleto (la <template> con
   SU propia forma) y el loader genérico de site.js pinta el esqueleto de
   inmediato y pega el HTML rendereado del server cuando llega. *@
<div class="container-fluid py-4">
    <div class="d-md-flex justify-content-md-between align-items-md-center mb-4">
        <partial name="_TituloSeccion" model='("Panel de Control", "Estado operativo del sistema en tiempo real")' />

        <div class="d-flex gap-2"
             data-cargar="/admin/parciales/estado-sistema"
             data-esqueleto="tpl-skeleton-estado"></div>
    </div>

    <!-- Resumen Diario -->
    <div class="row g-3 mb-4"
         data-cargar="/admin/parciales/resumen-diario"
         data-esqueleto="tpl-skeleton-resumen"></div>

    <!-- Cards de 3 columnas -->
    <div class="row g-3">
        <!-- Columna 1: Productos Bajo Stock -->
        <div class="col-12 col-lg-4">
            <div data-cargar="/admin/parciales/productos-bajo-stock"
                 data-esqueleto="tpl-skeleton-bajo-stock"></div>
        </div>

        <!-- Columna 2: Actividad Reciente -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm bg-body-tertiary h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-journal-text me-2 text-primary"></i>Actividad Reciente
                    </h5>
                </div>
                <div class="card-body"
                     data-cargar="/admin/parciales/ultimos-cambios"
                     data-esqueleto="tpl-skeleton-actividad"></div>
            </div>
        </div>

        <!-- Columna 3: Atención Requerida -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm bg-body-tertiary h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Atención Requerida
                        <span class="badge bg-danger placeholder-glow" id="badge-atencion"><span class="placeholder col-2">&nbsp;&nbsp;</span><span class="visually-hidden">cargando</span></span>
                    </h5>
                </div>
                <div class="card-body overflow-y-auto" id="pedidos-estancados-container"
                     data-cargar="/admin/pedidos-estancados?pagina=1"
                     data-esqueleto="tpl-esqueleto-filas"
                     data-error="tpl-error-widget"></div>
            </div>
        </div>
    </div>

    <!-- Movimientos de Stock -->
    <div class="row g-3 mt-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-body-tertiary">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-box-seam me-2 text-primary"></i>Movimientos de Stock Recientes
                    </h5>
                </div>
                <div class="card-body p-0"
                     data-cargar="/admin/parciales/movimientos-stock"
                     data-esqueleto="tpl-skeleton-movimientos"></div>
            </div>
        </div>
    </div>

    <!-- Pedidos Recientes -->
    <div class="row g-3 mt-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-body-tertiary">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-clock-history text-primary me-2"></i>
                            Pedidos Recientes
                        </h5>
                        <a asp-controller="AdminPedidos" asp-action="Listado" class="btn btn-sm btn-outline-primary">
                            Ver todos <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
                <div class="card-body"
                     data-cargar="/admin/parciales/pedidos-recientes"
                     data-esqueleto="tpl-skeleton-pedidos"></div>
            </div>
        </div>
    </div>
</div>

@* Formas de la carga (cada vista su esqueleto): la maquinaria es la única
   función de site.js; el aviso de error es compartido por todos los widgets
   (el Reintentar del propio loader recarga la última dirección del widget). *@
<template id="tpl-skeleton-estado">
    <span class="badge rounded-pill bg-secondary p-2 px-3 placeholder-glow"><span class="placeholder col-8">&nbsp;</span></span>
    <span class="badge rounded-pill bg-secondary p-2 px-3 placeholder-glow"><span class="placeholder col-8">&nbsp;</span></span>
</template>

<template id="tpl-skeleton-resumen">
    @for (int i = 0; i < 4; i++)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100" aria-hidden="true">
                <div class="card-body placeholder-glow">
                    <p class="small text-muted mb-1"><span class="placeholder col-6"></span></p>
                    <h3 class="mb-0"><span class="placeholder col-5"></span></h3>
                    <div class="mt-2"><span class="placeholder col-2"></span></div>
                </div>
            </div>
        </div>
    }
</template>

<template id="tpl-skeleton-bajo-stock">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pt-4 pb-3">
            <h5 class="mb-0 fw-semibold placeholder-glow"><span class="placeholder col-7"></span></h5>
        </div>
        <div class="card-body" aria-hidden="true">
            <div class="placeholder-glow">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex align-items-center mb-3">
                        <span class="placeholder rounded me-3" style="width: 45px; height: 45px;"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1"></span>
                            <span class="placeholder col-4"></span>
                        </div>
                        <span class="placeholder col-2"></span>
                    </div>
                }
            </div>
        </div>
    </div>
</template>

<template id="tpl-skeleton-actividad">
    <div class="position-relative ps-4" aria-hidden="true">
        <div class="position-absolute top-0 bottom-0 start-0 border-start border-secondary-subtle" style="margin-left: 10px;"></div>
        <div class="placeholder-glow">
            @for (int i = 0; i < 3; i++)
            {
                <div class="position-relative mb-3">
                    <span class="position-absolute top-0 start-0 translate-middle-x rounded-circle bg-secondary-subtle"
                          style="width: 12px; height: 12px; margin-left: -13px; margin-top: 6px; z-index: 2;"></span>
                    <div class="ms-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="placeholder col-4"></span><span class="placeholder col-2"></span>
                        </div>
                        <span class="placeholder col-7"></span>
                    </div>
                </div>
            }
        </div>
    </div>
</template>

<template id="tpl-esqueleto-filas">
    <div class="placeholder-glow" aria-hidden="true">
        @for (int i = 0; i < 3; i++)
        {
            <div class="card bg-body-tertiary border-0 shadow-sm mb-2">
                <div class="card-body py-2 px-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="placeholder col-4"></span><span class="placeholder col-2"></span>
                    </div>
                    <span class="placeholder col-6"></span>
                    <div class="d-flex justify-content-end mt-2"><span class="placeholder col-2"></span></div>
                </div>
            </div>
        }
    </div>
</template>

<template id="tpl-skeleton-movimientos">
    <div class="row row-cols-1 row-cols-sm-2 g-2 p-2" aria-hidden="true">
        @for (int i = 0; i < 4; i++)
        {
            <div class="col">
                <div class="card bg-body-tertiary border border-secondary-subtle border-1 h-100">
                    <div class="card-body py-2 placeholder-glow">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="placeholder col-6"></span><span class="placeholder col-2"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="placeholder col-3"></span><span class="placeholder col-3"></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</template>

<template id="tpl-skeleton-pedidos">
    <div class="placeholder-glow" aria-hidden="true">
        <div class="d-flex justify-content-between mb-3"><span class="placeholder col-3"></span><span class="placeholder col-2"></span></div>
        <table class="table">
            <thead>
                <tr>
                    @for (int i = 0; i < 5; i++)
                    {
                        <th class="bg-transparent"><span class="placeholder col-7"></span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < 4; i++)
                {
                    <tr>
                        <td class="bg-transparent"><span class="placeholder col-4"></span></td>
                        <td class="bg-transparent"><span class="placeholder col-6"></span></td>
                        <td class="bg-transparent"><span class="placeholder col-6"></span></td>
                        <td class="bg-transparent text-end"><span class="placeholder col-5"></span></td>
                        <td class="bg-transparent text-center"><span class="placeholder col-6"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</template>

<template id="tpl-error-widget">
    <div class="text-center py-4">
        <i class="bi bi-wifi-off fs-1 text-secondary opacity-50"></i>
        <p class="text-muted mt-2 mb-2">No se pudo cargar esta sección. Podés reintentar; si persiste, avisale a soporte.</p>
        <button type="button" class="btn btn-sm btn-outline-primary js-reintentar-widget">
            <i class="bi bi-arrow-clockwise me-1"></i>Reintentar
        </button>
    </div>
</template>

@section Scripts {
    <script src="~/js/Features/Home/IndexAdmin.js" asp-append-version="true"></script>
}
