@using TiendaOnline.Features.Home
@model HomeAdminViewModel
@* Fragmento del widget "Atención Requerida" que el JS pega dentro de
   #pedidos-estancados-container. El molde de las filas vive UNA vez acá (Razor
   auto-escapa el nombre del cliente, dato controlado por cualquier usuario):
   los atributos data-* del contenedor raíz son el contrato con IndexAdmin.js
   (sincroniza paginación y badge). *@
<div data-pagina-actual="@Model.PaginaActual"
     data-total-paginas="@Model.TotalPaginas"
     data-total-registros="@Model.TotalRegistros">
    @if (Model.PedidosEstancados.Count == 0)
    {
        <div class="text-center py-4">
            <i class="bi bi-check2-circle fs-1 text-success opacity-50"></i>
            <p class="text-muted mt-2 mb-0">Todo al día. No hay pedidos que esperen.</p>
        </div>
    }
    else
    {
        @foreach (var pedido in Model.PedidosEstancados)
        {
            <div class="card bg-body-tertiary border-0 shadow-sm mb-2 border-start border-3 border-@(pedido.ClaseColor)">
                <div class="card-body py-2 px-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-semibold small">Pedido #@pedido.PedidoId</span>
                        <span class="badge bg-@(pedido.ClaseColor) small">@Math.Floor(pedido.HorasTranscurridas) hs</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted"><i class="bi bi-person me-1"></i>@pedido.Cliente</small>
                    </div>
                    <div class="d-flex justify-content-end">
                        <a href="/Pedidos/Detalles/@pedido.PedidoId" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Revisar pedido">
                            <i class="bi bi-eye me-1"></i>Revisar
                        </a>
                    </div>
                </div>
            </div>
        }
    }

    @if (Model.TotalPaginas > 1)
    {
        const int radio = 2;
        <nav aria-label="Paginación de pedidos estancados">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" id="btn-anterior" aria-label="Anterior">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    if (i == 1 || i == Model.TotalPaginas || (i >= Model.PaginaActual - radio && i <= Model.PaginaActual + radio))
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link page-number" href="#" data-pagina="@i">@i</a>
                        </li>
                    }
                    else if (i == Model.PaginaActual - radio - 1 || i == Model.PaginaActual + radio + 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" href="#" id="btn-siguiente" aria-label="Siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
