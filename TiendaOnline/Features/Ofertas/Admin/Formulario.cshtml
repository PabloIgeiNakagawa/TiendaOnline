@model TiendaOnline.Features.Ofertas.OfertaFormularioViewModel
@{
    ViewData[ViewDataKeys.Title] = Model.OfertaId == 0 ? "Nueva Oferta" : "Editar Oferta";
    var esAlta = Model.OfertaId == 0;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">

            <partial name="_TituloSeccion" model='(esAlta ? "Nueva Oferta" : "Editar Oferta",
                esAlta ? "Definí el precio promocional y la ventana de vigencia" : Model.NombreProducto)' />

            <div class="card rounded-3 border border-1">
                <div class="card-body">
                    <form asp-action="@(esAlta ? "Crear" : "Editar")" asp-route-id="@(esAlta ? null : (int?)Model.OfertaId)" method="post">
                        @Html.AntiForgeryToken()

                        @if (esAlta)
                        {
                            <div class="mb-3">
                                <label asp-for="ProductoId" class="form-label fw-semibold"></label>
                                <select asp-for="ProductoId" class="form-select" asp-items="Model.Productos">
                                    <option value="">— Seleccioná un producto —</option>
                                </select>
                                <span asp-validation-for="ProductoId" class="text-danger small"></span>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="ProductoId" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Producto</label>
                                <div class="form-control bg-light">@Model.NombreProducto</div>
                            </div>
                            <div class="alert alert-light border small mb-3">
                                <i class="bi bi-info-circle me-1"></i>Precio de lista actual:
                                <strong>@Model.PrecioLista.ToString("C0")</strong> —
                                el precio de oferta debe ser <strong>menor</strong> a ese valor.
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="PrecioOferta" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrecioOferta" type="number" step="0.01" min="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="PrecioOferta" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FechaInicio" class="form-label fw-semibold"></label>
                                <input asp-for="FechaInicio" type="datetime-local" step="60" class="form-control" />
                                <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaFin" class="form-label fw-semibold"></label>
                                <input asp-for="FechaFin" type="datetime-local" step="60" class="form-control" />
                                <span asp-validation-for="FechaFin" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary flex-fill rounded-3">
                                <i class="bi bi-check-circle me-2"></i>@(esAlta ? "Crear oferta" : "Guardar cambios")
                            </button>
                            <a asp-action="Listado" class="btn btn-outline-secondary rounded-3">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
