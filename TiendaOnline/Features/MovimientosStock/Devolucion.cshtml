@using TiendaOnline.Features.Shared
@using TiendaOnline.Application.MovimientosStock.Queries
@using TiendaOnline.Domain.Entities
@model DatosDevolucionDto
@{
    ViewData[ViewDataKeys.Title] = "Registrar devolución";
}

<div class="container-fluid py-4">
    <partial name="_TituloSeccion"
        model='("Registrar devolución", "El stock vuelve al inventario y el movimiento queda en el historial con la referencia del pedido.")' />

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="card rounded-3 border mb-4">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <div class="me-auto">
                        <div class="text-muted small">Pedido</div>
                        <span class="fw-bold fs-5">#@Model.PedidoId.ToString("D6")</span>
                        @if (!string.IsNullOrEmpty(Model.ClienteNombre))
                        {
                            <span class="text-muted ms-2">· @Model.ClienteNombre</span>
                        }
                    </div>
                    <a asp-controller="Pedidos" asp-action="Detalles" asp-route-id="@Model.PedidoId"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Ver pedido
                    </a>
                </div>
            </div>

            @if (!Model.AdmiteDevolucion)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    La devolución solo aplica a pedidos <strong>Enviado</strong> o <strong>Entregado</strong>.
                    Este pedido está en estado <strong>@Model.Estado.ToString()</strong>:
                    los de antes se anulan con la cancelación (que ya devuelve el stock por su propio camino).
                </div>
            }
            else
            {
                <div class="card rounded-3 border">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-arrow-return-left me-2"></i>Productos del pedido</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        @foreach (var item in Model.Items)
                        {
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="mb-2">
                                    <div class="fw-semibold">@item.ProductoNombre</div>
                                    <div class="small text-muted">
                                        Compradas: <strong>@item.CantidadComprada</strong> ·
                                        Ya devueltas: <strong>@item.CantidadDevuelta</strong> ·
                                        Quedan por devolver: <strong>@item.QuedanPorDevolver</strong>
                                    </div>
                                </div>

                                @if (item.QuedanPorDevolver <= 0)
                                {
                                    <div class="alert alert-success mb-0 py-2 small">
                                        <i class="bi bi-check-circle me-1"></i>Este producto ya se devolvió completo.
                                    </div>
                                }
                                else
                                {
                                    <form asp-action="RegistrarDevolucion" method="post" class="row g-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PedidoId" value="@Model.PedidoId" />
                                        <input type="hidden" name="ProductoId" value="@item.ProductoId" />
                                        <div class="col-4 col-md-auto">
                                            <label class="form-label small fw-semibold mb-0">Unidades</label>
                                            <input type="number" name="Cantidad" value="1" min="1" max="@item.QuedanPorDevolver"
                                                   class="form-control" style="width: 110px;" />
                                        </div>
                                        <div class="col">
                                            <label class="form-label small fw-semibold mb-0">Motivo</label>
                                            <input type="text" name="Observaciones" class="form-control"
                                                   placeholder="Ej: el cliente lo devolvió sin abrir" required minlength="5" />
                                        </div>
                                        <div class="col-12 col-md-auto">
                                            <button type="submit" class="btn btn-warning w-100">
                                                <i class="bi bi-arrow-return-left me-1"></i>Registrar
                                            </button>
                                        </div>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
