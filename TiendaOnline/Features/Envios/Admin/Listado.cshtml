@model TiendaOnline.Features.Envios.Admin.EnvioListadoViewModel
@{
    ViewData["Title"] = "Envíos";
}

<div class="container-fluid py-4">
    <!-- Sección de Encabezado -->
    <div class="row mb-4">
        <div class="col-12">
            <partial name="_TituloSeccion" model='("Envíos", "Costo de envío a domicilio por provincia. Deshabilitar una zona bloquea el despacho a esos destinos.")' />
        </div>
    </div>

    <!-- Listado editable: una fila por provincia, cada fila con su propio form -->
    <div class="card rounded-3 border border-1">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Provincia</th>
                            <th style="max-width: 180px;">Costo</th>
                            <th>Zona habilitada</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var zona in Model.Zonas)
                        {
                            <tr data-zona="@zona.ZonaEnvioId" class="@(zona.Activa ? "" : "table-light")">
                                <td class="fw-semibold">
                                    @zona.Provincia
                                    @if (!zona.Activa)
                                    {
                                        <span class="badge bg-secondary ms-1">Deshabilitada</span>
                                    }
                                </td>
                                <td colspan="2">
                                    <form asp-controller="AdminEnvios" asp-action="Editar" method="post" id="form-zona-@zona.ZonaEnvioId" class="row row-cols-lg-auto g-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" asp-for="@zona.ZonaEnvioId" />
                                        <div class="col">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">$</span>
                                                <input type="number" step="0.01" min="0" max="1000000"
                                                       class="form-control @(ViewData.ModelState[$"Costo"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                                       name="Costo" value="@zona.Costo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                       data-costo-original="@zona.Costo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                       style="max-width: 140px;" />
                                            </div>
                                        </div>
                                        <div class="col-2">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input switch-zona" type="checkbox" name="Activa" value="true" @(zona.Activa ? "checked" : "") data-id="@zona.ZonaEnvioId" title="Marcar/desmarcar habilita o deshabilita la zona al guardar" />
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-check-lg"></i> Guardar
                                            </button>
                                        </div>
                                        <input type="hidden" name="Provincia" value="@zona.Provincia" />
                                    </form>
                                </td>
                                <td class="text-end"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
