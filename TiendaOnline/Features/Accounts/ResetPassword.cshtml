@using TiendaOnline.Features.Accounts
@model ResetPasswordViewModel
@{
    ViewData[ViewDataKeys.Title] = "Nueva contraseña";
}

@section Styles{
    <style>
        .input-icon {
            left: 1rem;
            transform: translateY(-50%);
            z-index: 3;
            transition: color 0.3s ease;
        }
    </style>
}

<div class="d-flex justify-content-center align-items-center my-5">
    <div class="position-relative rounded-4 border border-1 overflow-hidden w-100" style="max-width: 400px;">
        <!-- Header -->
        <div class="position-relative text-center pt-4 px-3 rounded-top-4">
            <i class="bi bi-key fs-1"></i>
            <h2 class="fw-bold mb-2">Nueva contraseña</h2>
            <p class="small opacity-75">Elegí tu nueva contraseña para continuar</p>
        </div>

        <!-- Body -->
        <div class="px-4 pb-5 pt-4">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <!-- Contraseña -->
                <div class="form-floating mb-4">
                    <input asp-for="Contrasena"
                           type="password"
                           class="form-control rounded-3 ps-5"
                           id="password"
                           placeholder="••••••••"
                           autocomplete="new-password"
                           required />
                    <label class="ps-5 text-body-secondary" for="password">Nueva contraseña</label>
                    <i class="bi bi-lock input-icon position-absolute top-50 text-body"></i>
                    <span asp-validation-for="Contrasena" class="d-block small mt-2 text-danger"></span>
                </div>

                <!-- Confirmación -->
                <div class="form-floating mb-4">
                    <input asp-for="ConfirmarContrasena"
                           type="password"
                           class="form-control rounded-3 ps-5"
                           id="confirmar"
                           placeholder="••••••••"
                           autocomplete="new-password"
                           required />
                    <label class="ps-5 text-body-secondary" for="confirmar">Confirmar contraseña</label>
                    <i class="bi bi-lock input-icon position-absolute top-50 text-body"></i>
                    <span asp-validation-for="ConfirmarContrasena" class="d-block small mt-2 text-danger"></span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                }

                <button type="submit" class="btn btn-primary w-100 p-2 rounded-3 fs-6 fw-semibold">
                    <i class="bi bi-check2-circle me-2"></i>
                    Guardar contraseña
                </button>
            </form>
        </div>
    </div>
</div>
