@using TiendaOnline.Features.Accounts
@model OlvideMiPasswordViewModel
@{
    ViewData[ViewDataKeys.Title] = "Recuperar contraseña";
}

@section Styles{
    <style>
        .input-icon {
            left: 1rem;
            transform: translateY(-50%);
            z-index: 3;
            transition: color 0.3s ease;
        }
    </style>
}

<div class="d-flex justify-content-center align-items-center my-5">
    <div class="position-relative rounded-4 border border-1 overflow-hidden w-100" style="max-width: 400px;">
        <!-- Header -->
        <div class="position-relative text-center pt-4 px-3 rounded-top-4">
            <i class="bi bi-shield-lock fs-1"></i>
            <h2 class="fw-bold mb-2">Recuperar contraseña</h2>
            <p class="small opacity-75">Te enviaremos un enlace para crear una nueva</p>
        </div>

        <!-- Body -->
        <div class="px-4 pb-5 pt-4">
            <form asp-action="OlvideMiPassword" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="form-floating mb-4">
                    <input asp-for="Email"
                           type="email"
                           class="form-control rounded-3 ps-5"
                           id="email"
                           placeholder="correo@ejemplo.com"
                           autocomplete="email"
                           required />
                    <label class="ps-5 text-body-secondary" for="email">Correo Electrónico</label>
                    <i class="bi bi-envelope input-icon position-absolute top-50 text-body"></i>
                    <span asp-validation-for="Email" class="d-block small mt-2 text-danger"></span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                }

                <button type="submit" class="btn btn-primary w-100 p-2 rounded-3 fs-6 fw-semibold">
                    <i class="bi bi-envelope me-2"></i>
                    Enviar enlace
                </button>
            </form>

            <div class="text-center mt-4 text-secondary">
                ¿Recordaste la contraseña?
                <a class="fw-semibold text-decoration-none link-underline-opacity-100-hover" asp-action="Login">Volver a iniciar sesión</a>
            </div>
        </div>
    </div>
</div>
