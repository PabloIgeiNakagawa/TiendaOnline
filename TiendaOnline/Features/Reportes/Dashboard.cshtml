@using TiendaOnline.Extensions
@{
    ViewData[ViewDataKeys.Title] = "Dashboard";
}
@section Styles{
    <style>
        @@media print {
            .btn, .card-header button {
                display: none !important;
            }

            .card {
                break-inside: avoid;
            }
        }
    </style>
}

@* CAPARAZÓN TODO DE GOLPE (mismo patrón que el panel de /admin): la página no
   consulta la base — sale casi de una con SUS esqueletos y el cuerpo completo
   llega en UN fetch (data-cargar del raíz contra Admin/AdminReportes/Secciones).
   El loader de site.js reparte el envase por data-seccion (misma clave en
   server y cliente) y pinta todos los contenedores juntos: ninguna sección
   aparece antes que las demás. El esqueleto de cada uno es la <template> que
   declara en data-esqueleto; los gráficos los arma Dashboard.js al escuchar el
   pintado de cada contenedor (fragmento:pintado). *@
<div class="container-fluid py-4" data-cargar="@Url.Action("Secciones")">
    <!-- Header del Dashboard (estático: no depende de la base) -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                @* Mismo bloque que el parcial _TituloSeccion, con el relojito vivo:
                   Dashboard.js actualiza #ultimaActualizacion cada minuto. *@
                <div>
                    <div class="d-flex align-items-center border-start border-primary border-4 ps-4">
                        <div>
                            <h2 class="display-6 fw-black text-primary text-uppercase tracking-widest mb-1 fw-medium" style="letter-spacing: 2px;">
                                Dashboards
                            </h2>
                            <p class="text-secondary small text-uppercase mb-0">Última actualización: <span id="ultimaActualizacion">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span></p>
                        </div>
                    </div>
                </div>
                <div>
                    <button id="btnImprimir" class="btn btn-outline-secondary">
                        <i class="bi bi-printer me-1"></i>Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Si Chart.js no llega (CDN caído, bloqueo de red), el JS muere en silencio y
       el dashboard queda sin gráficos ni explicación: este banner lo despierta. *@
    <div id="graficos-averia" class="alert alert-warning d-none mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>Los gráficos no pudieron cargarse. Probá recargar la página; si persiste, avisá al equipo técnico.
    </div>

    <!-- Tarjetas de Métricas Principales -->
    <div class="row g-3 mb-4"
         data-seccion="metricas"
         data-esqueleto="tpl-skeleton-metricas"></div>

    <!-- Métrica Secundaria: Tiempo de Preparación -->
    <div class="row g-3 mb-4"
         data-seccion="preparacion"
         data-esqueleto="tpl-skeleton-tarjeta"></div>

    <!-- Gráficos Principales -->
    <div class="row g-3 mb-4">
        <!-- Gráfico de Ventas por Mes -->
        <div class="col-12 col-lg-8">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-graph-up text-primary me-2"></i>
                        Ventas de los Últimos 12 Meses
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="grafico-ventas"
                     data-esqueleto="tpl-skeleton-grafico"></div>
            </div>
        </div>

        <!-- Gráfico de Estados de Pedidos -->
        <div class="col-12 col-lg-4">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-pie-chart text-primary me-2"></i>
                        Estado de Pedidos
                    </h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center"
                     data-seccion="grafico-estados"
                     data-esqueleto="tpl-skeleton-grafico"></div>
            </div>
        </div>
    </div>

    <!-- Ventas por Categoría y Método de Pago -->
    <div class="row g-3 mb-4">
        <!-- Ventas por Categoría -->
        <div class="col-12 col-lg-6">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-tag text-primary me-2"></i>
                        Ventas por Categoría
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="ventas-categoria"
                     data-esqueleto="tpl-skeleton-progress"></div>
            </div>
        </div>

        <!-- Ventas por Método de Pago -->
        <div class="col-12 col-lg-6">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-credit-card text-primary me-2"></i>
                        Ventas por Método de Pago
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="ventas-metodo-pago"
                     data-esqueleto="tpl-skeleton-tabla"></div>
            </div>
        </div>
    </div>

    <!-- Top Productos y Top Clientes -->
    <div class="row g-3 mb-4">
        <!-- Top Productos -->
        <div class="col-12 col-lg-6">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-trophy text-primary me-2"></i>
                        Top 5 Productos Más Vendidos
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="top-productos"
                     data-esqueleto="tpl-skeleton-lista"></div>
            </div>
        </div>

        <!-- Top Clientes -->
        <div class="col-12 col-lg-6">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-star text-primary me-2"></i>
                        Top 5 Mejores Clientes
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="top-clientes"
                     data-esqueleto="tpl-skeleton-tabla"></div>
            </div>
        </div>
    </div>

    <!-- Pedidos por Día y Hora -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card bg-body-tertiary border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-calendar2-week text-primary me-2"></i>
                        Pedidos por Día y Hora
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="dia-hora"
                     data-esqueleto="tpl-skeleton-grafico"></div>
            </div>
        </div>
    </div>

    <!-- Stock Inmovilizado (Productos "Hueso") -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card bg-body-tertiary border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-box-seam text-danger me-2"></i>
                        Stock Inmovilizado (sin ventas en 90 días)
                    </h5>
                </div>
                <div class="card-body"
                     data-seccion="stock-inmovilizado"
                     data-esqueleto="tpl-skeleton-tabla"></div>
            </div>
        </div>
    </div>
</div>

@* Formas de la carga (cada vista su esqueleto): la maquinaria vive una vez en
   site.js. El aviso de error es compartido y su Reintentar repite la última
   carga de lo que falló: acá vuelve a pedir el dashboard completo. *@
<template id="tpl-skeleton-metricas">
    @for (int i = 0; i < 4; i++)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-body-tertiary border-0 shadow-sm h-100" aria-hidden="true">
                <div class="card-body placeholder-glow">
                    <p class="small text-muted mb-1"><span class="placeholder col-6"></span></p>
                    <h3 class="mb-0"><span class="placeholder col-7"></span></h3>
                    <div class="mt-3"><span class="placeholder col-4"></span></div>
                </div>
            </div>
        </div>
    }
</template>

<template id="tpl-skeleton-tarjeta">
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card bg-body-tertiary border-0 shadow-sm h-100" aria-hidden="true">
            <div class="card-body placeholder-glow">
                <div class="d-flex justify-content-between align-items-start">
                    <p class="small text-muted mb-1 flex-grow-1"><span class="placeholder col-8"></span></p>
                    <span class="placeholder rounded-3" style="width: 48px; height: 48px;"></span>
                </div>
                <h3 class="mt-3 mb-0"><span class="placeholder col-6"></span></h3>
            </div>
        </div>
    </div>
</template>

<template id="tpl-skeleton-grafico">
    <div class="placeholder-glow" aria-hidden="true">
        <span class="placeholder w-100" style="height: 240px;"></span>
    </div>
</template>

<template id="tpl-skeleton-progress">
    <div class="placeholder-glow" aria-hidden="true">
        @for (int i = 0; i < 4; i++)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="placeholder col-4"></span>
                    <span class="placeholder col-2"></span>
                </div>
                <span class="placeholder col-10" style="height: 8px;"></span>
                <div class="mt-1"><span class="placeholder col-6"></span></div>
            </div>
        }
    </div>
</template>

<template id="tpl-skeleton-tabla">
    <div class="placeholder-glow" aria-hidden="true">
        <table class="table">
            <thead>
                <tr>
                    @for (int i = 0; i < 4; i++)
                    {
                        <th class="bg-transparent"><span class="placeholder col-7"></span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < 4; i++)
                {
                    <tr>
                        <td class="bg-transparent"><span class="placeholder col-6"></span></td>
                        <td class="bg-transparent"><span class="placeholder col-4"></span></td>
                        <td class="bg-transparent"><span class="placeholder col-5"></span></td>
                        <td class="bg-transparent text-end"><span class="placeholder col-4"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</template>

<template id="tpl-skeleton-lista">
    <div class="placeholder-glow" aria-hidden="true">
        @for (int i = 0; i < 3; i++)
        {
            <div class="d-flex align-items-center mb-3">
                <span class="placeholder rounded me-3" style="width: 50px; height: 50px;"></span>
                <div class="flex-grow-1">
                    <span class="placeholder col-6 d-block mb-1"></span>
                    <span class="placeholder col-4"></span>
                </div>
                <span class="placeholder col-1"></span>
            </div>
        }
    </div>
</template>

<template id="tpl-error-widget">
    <div class="text-center py-4">
        <i class="bi bi-wifi-off fs-1 text-secondary opacity-50"></i>
        <p class="text-muted mt-2 mb-2">No se pudo cargar esta sección. Podés reintentar; si persiste, avisale a soporte.</p>
        <button type="button" class="btn btn-sm btn-outline-primary js-reintentar-widget">
            <i class="bi bi-arrow-clockwise me-1"></i>Reintentar
        </button>
    </div>
</template>

@section Scripts {
    <!-- Chart.js AUTOALOJADO (D2): antes venía por CDN — tercero imprescindible
         para que el dashboard tenga gráficos. El archivo vive en wwwroot y
         asp-append-version lo refresca por huella. -->
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/Features/Reportes/Dashboard.js" asp-append-version="true"></script>
}
