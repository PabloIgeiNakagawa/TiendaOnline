@using TiendaOnline.Features.Reportes
@model MetricasGenerales
@* Contenido de las tarjetas de Métricas Principales: la fila madre vive en el
   caparazón de Dashboard (data-seccion="metricas"); acá van sus columnas. *@
<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Ventas del Mes</p>
                    <h3 class="mb-0 fw-bold">@Model.VentasMesActual.ToString("C")</h3>
                </div>
                <div class="bg-success bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-cash-coin text-success fs-4"></i>
                </div>
            </div>
            <div class="mt-3">
                @if (Model.PorcentajeCambioVentas >= 0)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-up"></i> @Model.PorcentajeCambioVentas.ToString("F1")%
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-down"></i> @Math.Abs(Model.PorcentajeCambioVentas).ToString("F1")%
                    </span>
                }
                <small class="text-muted ms-2">vs mes anterior</small>
            </div>
        </div>
    </div>
</div>

<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Pedidos del Mes</p>
                    <h3 class="mb-0 fw-bold">@Model.PedidosMesActual</h3>
                </div>
                <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-cart-check text-primary fs-4"></i>
                </div>
            </div>
            <div class="mt-3">
                @if (Model.PorcentajeCambioPedidos >= 0)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-up"></i> @Model.PorcentajeCambioPedidos.ToString("F1")%
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-down"></i> @Math.Abs(Model.PorcentajeCambioPedidos).ToString("F1")%
                    </span>
                }
                <small class="text-muted ms-2">vs mes anterior</small>
            </div>
        </div>
    </div>
</div>

<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Nuevos Clientes</p>
                    <h3 class="mb-0 fw-bold">@Model.ClientesMesActual</h3>
                </div>
                <div class="bg-info bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-people text-info fs-4"></i>
                </div>
            </div>
            <div class="mt-3">
                @if (Model.PorcentajeCambioClientes >= 0)
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-arrow-up"></i> @Model.PorcentajeCambioClientes.ToString("F1")%
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-arrow-down"></i> @Math.Abs(Model.PorcentajeCambioClientes).ToString("F1")%
                    </span>
                }
                <small class="text-muted ms-2">vs mes anterior</small>
            </div>
        </div>
    </div>
</div>

<div class="col-12 col-sm-6 col-xl-3">
    <div class="card bg-body-tertiary border-0 shadow-sm h-100">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 small">Ticket Promedio</p>
                    <h3 class="mb-0 fw-bold">@Model.PromedioVentaPorPedido.ToString("C")</h3>
                </div>
                <div class="bg-success bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-receipt text-success fs-4"></i>
                </div>
            </div>
            <div class="mt-3">
                <small class="text-muted">Promedio por compra</small>
            </div>
        </div>
    </div>
</div>
