@model TiendaOnline.Features.Usuarios.CambiarPasswordViewModel
@{
    ViewData[ViewDataKeys.Title] = "Cambiar Contraseña";
}

<div class="container py-4" style="max-width: 640px;">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <i class="bi bi-house-door me-1"></i>Inicio
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="PerfilUsuario" asp-route-id="@ViewContext.RouteData.Values["id"]" class="text-decoration-none">Mi Perfil</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Cambiar Contraseña</li>
        </ol>
    </nav>

    <div class="card rounded-3 border-1">
        <div class="card-header bg-transparent border-bottom rounded-top-3 px-4 py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-shield-lock me-2 text-primary"></i>
                Cambiar Contraseña
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="CambiarPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ContrasenaActual" class="form-label fw-semibold">Contraseña actual</label>
                    <input asp-for="ContrasenaActual" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContrasenaNueva" class="form-label fw-semibold">Nueva contraseña</label>
                    <input asp-for="ContrasenaNueva" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ContrasenaNueva" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmarContrasena" class="form-label fw-semibold">Confirmar nueva contraseña</label>
                    <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="PerfilUsuario" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver al perfil
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
